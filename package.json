{
  "name": "template-vue-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{vue,js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint"
    ],
    "!(*.vue|*.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs)": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || >=22.12.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=12.6.0"
  }
}
